# Migrations and seed run as the database owner.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/sip
# The API connects as a non-superuser so row-level security applies.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/sip

PORT=3000
APP_URL=http://localhost:5173

# Development sign-in. Never enable in production. See apps/api/src/auth.
DEV_AUTH=1

# WhatsApp Cloud API. Leave blank to log messages to the console instead of sending.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
